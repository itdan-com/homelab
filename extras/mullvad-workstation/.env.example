# Copy to .env and fill in.  .env is gitignored (never committed).
#   cp .env.example .env

# --- Mullvad WireGuard ---
# Get these from mullvad.net -> log in -> "WireGuard configuration" ->
# generate a key. The downloaded config has a [Interface] PrivateKey and an
# Address (an internal 10.x / fc00: address). Paste them here.
WIREGUARD_PRIVATE_KEY=
WIREGUARD_ADDRESSES=10.0.0.0/32
# Optional exit location. Country filter (recommended) and/or a specific city.
# Examples:  MULLVAD_COUNTRIES=Switzerland,Sweden    MULLVAD_CITIES=Zurich
# Blank = Mullvad picks automatically (any country).
MULLVAD_COUNTRIES=
MULLVAD_CITIES=

# --- Your LAN (lets the desktop reach the file server + you reach the GUI) ---
# Use your actual home subnet. Find it on Windows with `ipconfig` (IPv4 +
# subnet mask -> CIDR). Common values: 192.168.1.0/24, 192.168.0.0/24, 10.0.0.0/24.
LAN_SUBNET=192.168.1.0/24

# --- Desktop web GUI login ---
GUI_USER=mullvad
GUI_PASSWORD=
GUI_PORT=3001

# --- Resources (shares the WSL2 pool with the homelab) ---
MEM_LIMIT=8g
CPU_LIMIT=4

TZ=America/Denver
