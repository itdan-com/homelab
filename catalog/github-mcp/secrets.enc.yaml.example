# Copy this to secrets.enc.yaml, paste your token, then encrypt IN PLACE:
#
#   cp catalog/github-mcp/secrets.enc.yaml.example catalog/github-mcp/secrets.enc.yaml
#   nano catalog/github-mcp/secrets.enc.yaml          # paste the token
#   sops -e -i catalog/github-mcp/secrets.enc.yaml    # encrypt in place
#   grep ENC catalog/github-mcp/secrets.enc.yaml      # verify before committing
#
# Mint the token at:
#   https://github.com/settings/personal-access-tokens/new
#
#   Resource owner : your org or account
#   Repositories   : the ones this platform may touch (all, or selected)
#   Permissions    : Contents        -> Read and write
#                    Pull requests   -> Read and write
#                    NOTHING ELSE — and specifically NOT Administration.
#
# Why that last line matters: this server has no repo allowlist of its
# own, so the token's scope IS the boundary. Withholding Administration
# means repository deletion is not "forbidden by policy" — it is
# impossible, and stays impossible even if Sentinel is compromised.
auth:
  token: ghp_REPLACE_ME
