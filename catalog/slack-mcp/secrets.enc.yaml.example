# Copy to secrets.enc.yaml, fill in, then encrypt IN PLACE:
#   sops -e -i catalog/slack-mcp/secrets.enc.yaml
#
# token  — a Slack app's USER token (xoxp-) or BOT token (xoxb-).
#          NEVER the xoxc/xoxd browser pair: those carry a human's full
#          privileges with no scope narrowing, are harvested from
#          devtools, and using them means running the upstream's
#          Chrome-impersonating TLS handshake to dodge Slack's
#          fingerprinting. Not a corporate posture.
#
# apiKey — the HTTP transport's shared key. Generate: openssl rand -hex 24
#          Load-bearing because the server FAILS OPEN without it, and
#          even with it only tools/call is guarded — session creation
#          and tools/list are not. The NetworkPolicy and the Sentinel
#          proxy are the real gate; this is defence in depth.
#
# The SAME apiKey value goes into Sentinel's Connections screen as the
# `slack` credential, because that is what the door sends upstream.
auth:
  token: xoxp-REPLACE-ME
  apiKey: REPLACE-ME
